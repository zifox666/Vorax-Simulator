# The Go server reads process environment; this file is a reference, not auto-loaded.
LISTEN_ADDR=127.0.0.1:8080
SIGNING_KEY_FILE=.local/signing.key
# Set the exact HTTPS origin when TLS is terminated by a reverse proxy.
# PUBLIC_ORIGIN=https://ky.dscan.icu
# Optional local compose services. Omit both to run with embedded sample content.
# DATABASE_URL=postgres://vorax:vorax_local_only@127.0.0.1:5432/vorax?sslmode=disable
# REDIS_URL=redis://127.0.0.1:6379/0
# Gameplay training data uses DATABASE_URL by default. Set a separate database
# here when desired. With neither URL configured, local development records none.
# TELEMETRY_DATABASE_URL=postgres://vorax:password@127.0.0.1:5432/vorax?sslmode=disable
# Stable pseudonyms across signing-key rotation require a dedicated random key.
# Generate at least 32 random bytes and encode them as Base64.
# TELEMETRY_HMAC_KEY_BASE64=
# For managed deployments use at least 32 random bytes, encoded as Base64.
# SIGNING_KEY_BASE64=
# SIGNING_KEY_ID=v1
# PREVIOUS_SIGNING_KEYS_JSON={"previous-key-id":"previous-base64-key"}
